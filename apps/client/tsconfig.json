{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@catanx/engine": ["../../packages/engine/src/index.ts"],
      "@catanx/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../../packages/protocol" }, { "path": "../../packages/engine" }]
}
